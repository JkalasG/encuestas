PORT=3000
JWT_SECRET=cambia-esto-por-un-secreto-largo
# Opcional: habilita "Iniciar sesion con Google"
GOOGLE_CLIENT_ID=
# Si es false, nadie mas puede crear cuentas con usuario/clave
REGISTRO_ABIERTO=false

# Usuario inicial (seed del primer arranque)
ADMIN_EMAIL=sgc@agencia-vilaseca.com
ADMIN_PASSWORD=EPSIUQzurc.97

# Activa o desactiva la funcion secreta romantica (true / false)
MODO_ESPECIAL=true

# Correos con la API de Gmail (confirmaciones de encuestas). Mismo esquema OAuth que backend-lici.
# Usa GMAIL_REFRESH_TOKEN, o GMAIL_TOKEN_FILE con la ruta a un token.json que tenga refresh_token.
# Para obtener el token: npm run gmail:token (necesita GMAIL_REDIRECT_URI autorizada en Google Cloud)
# Scopes necesarios: gmail.send, gmail.labels y gmail.modify
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=
GMAIL_REFRESH_TOKEN=
GMAIL_TOKEN_FILE=
SENDER_ALIAS=
SENDER_NAME=Encuestas Vilaseca
